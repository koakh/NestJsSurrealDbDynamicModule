{
  "name": "@koakh/nestjs-surrealdb-rest-demo",
  "version": "0.3.0",
  "description": "SurrealDb NestJs wrapper driver - Consumer app",
  "author": "Mário Monteiro <marioammonteiro@gmail.com>",
  "readmeFilename": "README.md",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --debug --watch",
    "start:debug": "nodemon --config nodemon-debug.json",
    "start:prod": "node dist/main",
    "kill:port": "sudo fuser -k 3030/tcp",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:build": "COMPOSE_BAKE=0 docker compose build",
    "docker:push": "docker push koakh/nestjs-surrealdb-rest-demo:0.3.0",
    "docker:up": "docker compose up",
    "docker:up:surrealdb": "docker-compose up nestjs-surrealdb-rest-surrealdb",
    "docker:down": "docker compose down --remove-orphans"
  },
  "// opt local/remote @koakh/nestjs-surrealdb": {
    "local": "file:../app-lib",
    "remote ": "^0.3.0"
  },
  "dependencies": {
    "@koakh/nestjs-surrealdb": "workspace:^",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "react-is": "^18.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
