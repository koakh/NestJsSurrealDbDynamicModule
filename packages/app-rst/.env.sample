# default local stack (docker compose `surreal:docker`, surrealdb v4 on host port 8001)
SURREALDB_URL="ws://127.0.0.1:8001/rpc"
SURREALDB_NAMESPACE="test"
SURREALDB_DATABASE="test"
SURREALDB_USERNAME="root"
SURREALDB_PASSWORD="root"

# optional: skip the connect on boot / log-and-continue on boot errors
# SURREALDB_INIT_SURREAL_DB="false"
# SURREALDB_INIT_SURREAL_DB_THROW_ERROR="false"

# optional: when set, every /surrealdb/* endpoint requires the `x-api-key` header to match
# SURREALDB_CONTROLLER_GUARD_KEY="change-me"

# override example: external stack (ex c3-system-stack / micropal)
# SURREALDB_URL="ws://127.0.0.1:8888/rpc"
# SURREALDB_NAMESPACE="micropal"
# SURREALDB_DATABASE="micropal"
# SURREALDB_USERNAME="root"
# SURREALDB_PASSWORD="get it from backend project"
