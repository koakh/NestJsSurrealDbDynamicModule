@host = localhost
@port = 3030
@uriBase = http://{{host}}:{{port}}
@uri = {{uriBase}}
@uriDb = {{uriBase}}/db
@uriSurrealDb = {{uriBase}}/surrealdb
@contentType = application/json

@thing = person:mario
@namespaceAndDatabase = test

### ::::: BO app-rst :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

// local AppModule:AppController

### getHello
// @name getHello
GET {{uri}} HTTP/1.1
Content-Type: {{contentType}}

### appLib SurrealDbModule

### getConfig
// @name getConfig
// call surrealDbService.getConfig()

GET {{uri}}/config HTTP/1.1
Content-Type: {{contentType}}

{
}

### getUserFindOneByField
// @name getUserFindOneByField
// call surrealDbService.getUserFindOneByField() (moked user)

GET {{uri}}/user-service HTTP/1.1
Content-Type: {{contentType}}

{
}

### ::::: EO app-rst :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

### ::::: BO app-rst db showcase (DbController) ::::::::::::::::::::::::::::::::::::::::::::::::

// record access auth flow (requires initdb `account` access)

### postDbSignup
// @name postDbSignup
// record access signup -> Tokens { access, refresh? }
// NOTE: `username` is UNIQUE (user.idx_username), re-running initdb wipes the db,
// otherwise change the username between runs (a duplicate returns 409)

POST {{uriDb}}/signup HTTP/1.1
Content-Type: {{contentType}}

{
  "username": "alex",
  "password": "password",
  "marketing": true,
  "tags": ["rust", "golang", "javascript"]
}

### postDbSignin
// @name postDbSignin
// record access signin -> Tokens { access, refresh? }

POST {{uriDb}}/signin HTTP/1.1
Content-Type: {{contentType}}

{
  "username": "alex",
  "password": "password"
}

### postDbSignout
// @name postDbSignout
// invalidate the current session authentication (logout),
// then restores the root system session so the demo keeps working

POST {{uriDb}}/signout HTTP/1.1
Content-Type: {{contentType}}

### getDbAuth
// @name getDbAuth
// the authenticated record user ($auth), pass ?token= from signup/signin to authenticate first

GET {{uriDb}}/auth?token={{postDbSignin.response.body.access}} HTTP/1.1
Content-Type: {{contentType}}

// user-defined functions

### getDbGreet
// @name getDbGreet
// run fn::greet (defined by initdb.surql)

GET {{uriDb}}/greet/mario HTTP/1.1
Content-Type: {{contentType}}

// CRUD with a nested validated DTO

### postDbCreatePerson
// @name postDbCreatePerson
// create with a nested validated DTO (invalid bodies return 400)

POST {{uriDb}}/person HTTP/1.1
Content-Type: {{contentType}}

{
  "title": "developer",
  "name": { "first": "Mario", "last": "Monteiro" },
  "marketing": true
}

### getDbPerson
// @name getDbPerson
// select person by id (from postDbCreatePerson response)

GET {{uriDb}}/person/{{postDbCreatePerson.response.body.id}} HTTP/1.1
Content-Type: {{contentType}}

// transactions

### postDbTransactionDemo
// @name postDbTransactionDemo
// beginTransaction -> CREATE person -> commit, in one endpoint

POST {{uriDb}}/transaction-demo HTTP/1.1
Content-Type: {{contentType}}

{
  "title": "tx-person",
  "name": { "first": "Trans", "last": "Action" }
}

// live queries

### postDbLiveDemo
// @name postDbLiveDemo
// starts a live query, writes a record, captures the events, kills and returns everything

POST {{uriDb}}/live-demo/live_person HTTP/1.1
Content-Type: {{contentType}}

### ::::: EO app-rst db showcase :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

### ::::: BO surrealdb.js v2 proxy methods (app-lib SurrealDbController) :::::::::::::::::::::

// connection

### getHealth
// @name getHealth
// v2 replacement for v1 `ping`, falls back to connection status when rpc not available

GET {{uriSurrealDb}}/health HTTP/1.1
Content-Type: {{contentType}}

### getStatus
// @name getStatus
// connection status: connecting | connected | reconnecting | disconnected | error

GET {{uriSurrealDb}}/status HTTP/1.1
Content-Type: {{contentType}}

### getIsConnected
// @name getIsConnected
// boolean shortcut for status === connected

GET {{uriSurrealDb}}/is-connected HTTP/1.1
Content-Type: {{contentType}}

### getIsFeatureSupported
// @name getIsFeatureSupported
// ex LiveQueries, Sessions, Api, RefreshTokens, Transactions, ExportImportRaw, SurrealML

GET {{uriSurrealDb}}/is-feature-supported/LiveQueries HTTP/1.1
Content-Type: {{contentType}}

### getVersion
// @name getVersion
// rpc version, ex { "version": "surrealdb-4.0.1" }
// (the SurrealQL version() FUNCTION is gone in v4, the rpc is the way)

GET {{uriSurrealDb}}/version HTTP/1.1
Content-Type: {{contentType}}

### postConnect
// @name postConnect
// rewire the SHARED connection to another endpoint (ex a second stack),
// url scheme allowlist: ws|wss|http|https|mem|rocksdb|surrealkv|fdb|tikv

POST {{uriSurrealDb}}/connect
Content-Type: application/json

{
  "url": "ws://127.0.0.1:8001/rpc"
}

### postClose
// @name postClose
// closes the shared connection, all further db requests fail until
// a new postConnect (auto-reconnect does not apply to deliberate closes)

POST {{uriSurrealDb}}/close
Content-Type: application/json

{
}

### postUse
// @name postUse
// switch the shared session to another namespace/database

POST {{uriSurrealDb}}/use
Content-Type: application/json

{
  "namespace": "{{namespaceAndDatabase}}",
  "database": "{{namespaceAndDatabase}}"
}

// events

### postSubscribeEvent
// @name postSubscribeEvent
// events: connecting, connected, reconnecting, disconnected, error, auth, using
// logs to the app console

POST {{uriSurrealDb}}/subscribe/connected
Content-Type: application/json

{
}

// sessions

### getSessions
// @name getSessions
// isolated sessions created on the shared connection (own ns/db/vars/auth state)

GET {{uriSurrealDb}}/sessions HTTP/1.1
Content-Type: {{contentType}}

### postNewSession
// @name postNewSession
// isolated namespace/database/variables/auth over the same connection

POST {{uriSurrealDb}}/session
Content-Type: application/json

{
}

### postForkSession
// @name postForkSession
// clone current session state

POST {{uriSurrealDb}}/session/fork
Content-Type: application/json

{
}

### deleteCloseSession
// @name deleteCloseSession
// WARNING: destructive! closeSession on the primary session is equivalent
// to `close()` — it kills the shared connection, all further requests fail
// until app restart. Only run this last (see maintenance section at the end)

### postReset
// @name postReset
// WARNING: destructive! resets the session state (clears auth, variables,
// namespace/database selection). See maintenance section at the end

// import / export

### postImport
// @name postImport
// SurrealDB v3+ requires `OPTION IMPORT;` first, it's prepended automatically

POST {{uriSurrealDb}}/import
Content-Type: application/json

{
  "data": "DEFINE TABLE person TYPE ANY SCHEMALESS PERMISSIONS FULL;"
}

### postExport
// @name postExport

POST {{uriSurrealDb}}/export
Content-Type: application/json

{
  "users": true,
  "accesses": true,
  "params": true,
  "functions": true,
  "analyzers": true,
  "tables": true,
  "records": true
}

// transactions
// begin returns an id, run queries with /transaction/:id/query, then commit or cancel

### postTransactionBegin
// @name postTransactionBegin

POST {{uriSurrealDb}}/transaction
Content-Type: application/json

{
}

### postTransactionQuery
// @name postTransactionQuery

POST {{uriSurrealDb}}/transaction/{{postTransactionBegin.response.body.id}}/query
Content-Type: application/json

{
  "query": "CREATE person:txn1 SET title = 'in txn'"
}

### postTransactionCommit
// @name postTransactionCommit

POST {{uriSurrealDb}}/transaction/{{postTransactionBegin.response.body.id}}/commit
Content-Type: application/json

{
}

### postTransactionCancel
// @name postTransactionCancel

POST {{uriSurrealDb}}/transaction/{{postTransactionBegin.response.body.id}}/cancel
Content-Type: application/json

{
}

// authentication

### postSignUp
// @name postSignUp
// SurrealDB 2.x+ record access, `initdb.surql` defines access `account`
// NOTE: `username` is UNIQUE, a duplicate returns 409 (re-run initdb to wipe, or change it)
// NOTE: signup ALSO authenticates the shared app session as the new record user

POST {{uriSurrealDb}}/signup
Content-Type: application/json

{
  "namespace": "{{namespaceAndDatabase}}",
  "database": "{{namespaceAndDatabase}}",
  "access": "account",
  "variables": {
    "username": "alex",
    "password": "password",
    "marketing": true,
    "tags": ["rust", "golang", "javascript"]
  }
}

### postSignIn
// @name postSignIn
// returns Tokens { access, refresh? }
// record access user ex below, or system user { "username": "root", "password": "root" }
// NOTE: this authenticates the SHARED app session (not per-request auth),
// run postSignInRoot afterwards to restore admin permissions

POST {{uriSurrealDb}}/signin
Content-Type: application/json

{
  "namespace": "{{namespaceAndDatabase}}",
  "database": "{{namespaceAndDatabase}}",
  "access": "account",
  "variables": {
    "username": "alex",
    "password": "password"
  }
}

### postSignInRoot
// @name postSignInRoot
// system user (root), restores admin permissions after a record user signin
// adjust the credentials to your target stack (ex the .env values)

POST {{uriSurrealDb}}/signin
Content-Type: application/json

{
  "username": "root",
  "password": "root"
}

### getAuth
// @name getAuth
// v2 replacement for v1 `info`, `SELECT * FROM $auth`
// returns the authenticated RECORD user (full user row), EMPTY when the session
// is a system user (root, the app boot state) or anonymous — $auth only exists
// for record users signed in through a DEFINE ACCESS ... TYPE RECORD.
// run postSignUp or postSignIn first (they authenticate the shared session),
// or use the friendlier GET /db/auth?token=<access> which reports the state

GET {{uriSurrealDb}}/auth HTTP/1.1
Content-Type: {{contentType}}

### postInvalidate
// @name postInvalidate
// invalidates the current session authentication, the session goes anonymous —
// privileged calls fail until the next signin/signup/authenticate

POST {{uriSurrealDb}}/invalidate
Content-Type: application/json

{
}

### postAuthenticate
// @name postAuthenticate
// authenticate the shared session from a token, ex after invalidate
// (also the way to adopt a record user session from postSignIn tokens)
// NOTE: access tokens live 15 MINUTES (initdb `DURATION FOR TOKEN 15m`),
// re-run postSignIn before this if it ran a while ago — an invalid OR expired
// token returns 401 (InvalidAuth)

POST {{uriSurrealDb}}/authenticate
Content-Type: application/json

{
  "token": "{{postSignIn.response.body.access}}"
}

// session configuration

### postSet
// @name postSet
// v2 replacement for v1 `let`
// check the value with getGet below (or POST /surrealdb/query `RETURN $name;`)

POST {{uriSurrealDb}}/set
Content-Type: application/json

{
  "variable": "name",
  "value": {
    "first": "Tobie",
    "last": "Morgan Hitchcock"
  }
}

### getGet
// @name getGet
// read a session variable back (the SDK has set/unset but no getter,
// this runs RETURN $<variable> under the hood), empty body when unset

GET {{uriSurrealDb}}/get/name HTTP/1.1
Content-Type: {{contentType}}

### postUnset
// @name postUnset
// check with getGet below, it will return null after this

POST {{uriSurrealDb}}/unset
Content-Type: application/json

{
  "variable": "name"
}

// queries

### postQuery
// @name postQuery
// mode: collect (default) | json | responses | stream
// v3 renamed `type::thing` to `type::record`

POST {{uriSurrealDb}}/query
Content-Type: application/json

{
  "query": "select * from person where id = type::record($id)",
  "bindings": {
    "id": "person:z0qapjrrofan52b4djor"
  }
}

### postQueryResponses
// @name postQueryResponses
// full response objects with stats

POST {{uriSurrealDb}}/query
Content-Type: application/json

{
  "query": "SELECT * FROM person LIMIT 1",
  "mode": "responses"
}

### postRun
// @name postRun
// Run a SurrealQL function, ex `fn::greet` from `initdb.surql`

POST {{uriSurrealDb}}/run/fn::greet
Content-Type: application/json

[
  "Tobie"
]

// surrealdb 3 user defined APIs
// proxies GET/POST/PUT/PATCH/DELETE /surrealdb/api/* to db.api()

### getApi
// @name getApi
// proxies to the server's user-defined API endpoints (`DEFINE API ...`),
// requires one defined on the server, else expect an error

GET {{uriSurrealDb}}/api/person HTTP/1.1
Content-Type: {{contentType}}

// live queries

### postLive
// @name postLive
// starts a managed live query and logs updates to the app console
// returns { id } to use with live-of and DELETE /live/:id

POST {{uriSurrealDb}}/live/person
Content-Type: application/json

{
}

### postLiveOf
// @name postLiveOf
// v2 replacement for v1 `subscribe-live`, subscribe to an existing live query id

POST {{uriSurrealDb}}/live-of/{{postLive.response.body.id}}
Content-Type: application/json

{
}

### deleteLive
// @name deleteLive
// v2 replacement for v1 `kill`

DELETE {{uriSurrealDb}}/live/{{postLive.response.body.id}} HTTP/1.1
Content-Type: {{contentType}}

// data methods

### getSelect
// @name getSelect
// optional builder params: ?where=&limit=&start=&fields=&fetch=
// selecting a record id that does not exist returns 404

GET {{uriSurrealDb}}/select/person:z0qapjrrofan52b4djor HTTP/1.1
Content-Type: application/json

### getSelectWithOptions
// @name getSelectWithOptions

GET {{uriSurrealDb}}/select/person?where=age >= 30&limit=2&start=0&fields=title,age HTTP/1.1
Content-Type: application/json

### postCreate
// @name postCreate
// NOTE: if use id `tb:id` result will be object, if use id `tb` result will be array
// creating a record id that already exists returns 409 (delete it first or use upsert)

POST {{uriSurrealDb}}/create/person:mario
Content-Type: application/json

{
  "data": {
    "title": "Founder & CEO",
    "name": {
      "first": "Mário",
      "last": "Monteiro"
    },
    "age": 50
  }
}

### postInsert
// @name postInsert

POST {{uriSurrealDb}}/insert/person
Content-Type: application/json

{
  "data": [
    {
      "title": "Multiple 1",
      "age": 20
    },
    {
      "title": "Multiple 2",
      "age": 30
    }
  ]
}

### putUpdate
// @name putUpdate
// mode: content (default, replace) | merge | patch

PUT {{uriSurrealDb}}/update/person:mario
Content-Type: application/json

{
  "data": {
    "name": {
      "first": "Mário",
      "last": "Monteiro"
    },
    "age": 50,
    "country": "Portugal"
  }
}

### putUpdateMerge
// @name putUpdateMerge

PUT {{uriSurrealDb}}/update/person:mario
Content-Type: application/json

{
  "data": {
    "newProp": "fooBar"
  },
  "mode": "merge"
}

### patchUpsert
// @name patchUpsert
// upsert is create-or-update, mode: content | merge | patch

PATCH {{uriSurrealDb}}/upsert/person:pedro
Content-Type: application/json

{
  "data": {
    "name": {
      "first": "Pedro",
      "last": "Monteiro"
    },
    "age": 50
  }
}

### deleteDelete
// @name deleteDelete

DELETE {{uriSurrealDb}}/delete/person:pedro HTTP/1.1
Content-Type: application/json

### postRelate
// @name postRelate
// single or fan-out (fromMany/toMany) relations
// implemented with a SurrealQL RELATE (v4 broke the sdk relate rpc marshalling)

POST {{uriSurrealDb}}/relate/likes
Content-Type: application/json

{
  "from": "person:mario",
  "to": "post:p1",
  "data": {
    "since": "today"
  }
}

### ::::: EO surrealdb.js v2 proxy methods ::::::::::::::::::::::::::::::::::::::::::::::::::::

### ::::: BO maintenance (destructive, run last!) :::::::::::::::::::::::::::::::::::::::::::::

// these operate on the shared connection/session, running them mid-suite
// breaks all subsequent requests (exactly what happens if you hit
// `postImport` after `deleteCloseSession`)

### postReset
// @name postReset
// resets the session: clears auth, variables and namespace/database selection

POST {{uriSurrealDb}}/reset
Content-Type: application/json

{
}

### deleteCloseSession
// @name deleteCloseSession
// kills the shared connection (closeSession == close on the primary session)
// the app needs a restart after this (auto-reconnect does not apply to
// deliberate closes)

DELETE {{uriSurrealDb}}/session HTTP/1.1
Content-Type: {{contentType}}

### ::::: EO maintenance ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
